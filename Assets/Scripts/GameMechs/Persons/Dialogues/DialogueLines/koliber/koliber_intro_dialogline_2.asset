  m_Name: koliber_intro_dialogline_2
  m_EditorClassIdentifier: 
  dialogLine: "\u201EBo widzisz\u2026 ja mam taki ma\u0142y\u2026 no\u2026 jakby\u2026
    nadmiar energii! Tak du\u017Co energiiii. Latam w t\u0105 i w tamt\u0105. Chcia\u0142am
    usi\u0105\u015B\u0107, ale przypomnia\u0142am sobie, \u017Ce mia\u0142am sprawdzi\u0107
    trzy kwiatki dalej i\u2026 i w sumie to zapomnia\u0142am, co ja sprawdza\u0142am.
    Wiesz jak jest.\u201D"
